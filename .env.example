# ─── LLM ────────────────────────────────────────────────────────────────────
# Ollama local model (open-source, fully offline)
OLLAMA_MODEL=qwen2.5:7b
OLLAMA_BASE_URL=http://localhost:11434

# ─── Currency ───────────────────────────────────────────────────────────────
CURRENCY_SYMBOL=Rs.

# ─── Email: Mailtrap Sandbox Setup ──────────────────────────────────────────
# 1. Sign up at mailtrap.io (free plan)
# 2. Open Email Testing → Inboxes → My Inbox
# 3. Click SMTP Settings and copy host, port, username, password
# 4. Leave SMTP_USER empty to fall back to demo mode (no actual send)
SMTP_HOST=sandbox.smtp.mailtrap.io
SMTP_PORT=2525
SMTP_USER=<your_mailtrap_user>
SMTP_PASS=<your_mailtrap_pass>
SMTP_FROM=agent@expense-report.dev

# ─── Email Recipient ────────────────────────────────────────────────────────
# Finance team email address (whitelist for send_email permission)
FINANCE_EMAIL=finance@yourcompany.com

# ─── Demo / Date override ────────────────────────────────────────────────────
# Optional: override "today" for reproducible demos (YYYY-MM-DD)
# Leave blank to use the real system date.
# The CSV is seeded for the month BEFORE this date.
REPORT_TODAY=2026-10-01

# ─── Phase 1: Memory ─────────────────────────────────────────────────────────
CHROMA_PERSIST_DIR=chroma_db
MEMORY_TOP_K=3
MEMORY_SIMILARITY_THRESHOLD=0.85
SHORT_TERM_WINDOW=5

# ─── Phase 1: Missing-data loop ──────────────────────────────────────────────
MAX_MISSING_RETRIES=2

# ─── Sentence-Transformers Caching (offline after first run) ───────────────
# Cache sentence-transformers models locally for fully offline operation
# Uncomment to configure custom cache dir (defaults to ~/.cache/huggingface)
HF_HOME=./huggingface_cache
SENTENCE_TRANSFORMERS_HOME=./huggingface_cache/sentence_transformers
